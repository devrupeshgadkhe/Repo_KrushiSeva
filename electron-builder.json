{
  "appId": "com.krushiseva.erp",
  "productName": "Krushi Seva ERP",
  "copyright": "Copyright © 2026 Rupesh Gadkhe",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Krushi Seva ERP",
    "uninstallDisplayName": "Krushi Seva ERP"
  },
  "publish": {
    "provider": "github",
    "owner": "devrupeshgadkhe",
    "repo": "Repo_KrushiSeva",
    "private": false
  }
}
