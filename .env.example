# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ========================================================
# Google Drive Automatic Database Backup Configuration
# ========================================================
# Enable or disable the automated backend backup scheduler (true/false)
BACKUP_ENABLED="true"

# Interval in hours between automatic backups (e.g., 24 for daily, 12 for twice a day)
BACKUP_INTERVAL_HOURS="24"

# Perform an initial backup check shortly after server startup (true/false)
BACKUP_ON_STARTUP="true"

# Number of days to retain backups in Google Drive (files older than this are deleted automatically)
BACKUP_RETENTION_DAYS="30"

# Maximum number of retry attempts on transient network or API failure
BACKUP_MAX_RETRIES="3"

# Google Cloud Service Account Email (e.g., backup-service@your-project-id.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"

# Google Cloud Service Account Private Key (from downloaded service account JSON)
# Keep newlines intact or escaped with \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: Dedicated Google Drive Folder ID.
# If omitted or left empty, the application automatically finds or creates a folder named 'Krushi_Seva_ERP_Backups'
GOOGLE_DRIVE_FOLDER_ID=""

# Optional: AES-256 encryption key (minimum 16 characters).
# If provided, backups are encrypted using AES-256-GCM before compression & upload.
# Leave empty if encryption is not required.
BACKUP_ENCRYPTION_KEY=""

# Path to local SQLite database file (defaults to ./data/krushi_seva_erp.db)
SQLITE_DB_PATH="./data/krushi_seva_erp.db"

